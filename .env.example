# Database URL
#
# LOCAL DEVELOPMENT (SQLite file):
DATABASE_URL="file:/home/z/my-project/db/custom.db"
#
# PRODUCTION (Vercel + Turso):
#   1. Buat database gratis di https://turso.tech
#   2. Jalankan: turso db create pdf-manager
#   3. Jalankan: turso db tokens create pdf-manager  (dapatkan token)
#   4. Jalankan: turso db show pdf-manager --url     (dapatkan URL)
#   Setel di Vercel Environment Variables:
#     DATABASE_URL="libsql://pdf-manager-xxxx.turso.io"
#     DATABASE_AUTH_TOKEN="xxxxx"
#
DATABASE_AUTH_TOKEN=""

# JWT Secret untuk autentikasi
# Generate dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-secret-key-yang-acak-dan-panjang"
