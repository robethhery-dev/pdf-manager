generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  password     String
  name         String
  role         String          @default("USER") // ADMIN or USER
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignments  PageAssignment[]

  @@map("users")
}

model PdfDocument {
  id           String          @id @default(cuid())
  filename     String          @unique
  originalName String
  totalPages   Int
  fileData     Bytes           // PDF binary stored in DB
  fileSize     Int
  uploadedBy   String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignments  PageAssignment[]

  @@map("pdf_documents")
}

model PageAssignment {
  id          String       @id @default(cuid())
  userId      String
  pdfId       String
  pageNumbers String       // JSON array of page numbers
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pdf         PdfDocument  @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  @@unique([userId, pdfId])
  @@map("page_assignments")
}
